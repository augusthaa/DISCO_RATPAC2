/tracking/verbose 0
/tracking/storeTrajectory 1
/tracking/discardParticleTrajectory opticalphoton

/rat/proc prune
/rat/procset prune "mc.track:opticalphoton"

/rat/db/set DETECTOR experiment "DISCO"
/rat/db/set DETECTOR geo_file "DISCO/construction_DISCO.geo"

/run/initialize

/vis/open VRML2FILE
/vis/drawVolume
/vis/viewer/flush

